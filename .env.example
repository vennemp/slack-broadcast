# OAuth & Permissions > Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-replace-me
# Basic Information > App-Level Tokens; scope: connections:write
SLACK_APP_TOKEN=xapp-replace-me
# Optional: comma-separated Slack member IDs allowed to broadcast.
# Empty means anyone in this workspace can use the app.
SLACK_ALLOWED_USER_IDS=
# Optional: enable App Home sender administration in local Socket Mode.
# With administrators set, SLACK_ALLOWED_USER_IDS initializes a local sender list;
# an empty list then means nobody is approved. Changes persist under DATA_DIR.
SLACK_ADMIN_USER_IDS=
# Delivery receipts contain channel IDs and timestamps, but no message text.
DATA_DIR=./data
# App branding. Run npm run manifest and apply the generated manifest in Slack
# to change the installed app name and message sender. Restart the app for UI changes.
SLACK_APP_NAME=Slack Broadcast
