{
  "name": "slack-broadcast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Compose once and send to multiple Slack channels.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vennemp/slack-broadcast.git"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/app.js",
    "start:cloud": "node --env-file-if-exists=.env src/cloud-app.js",
    "dev": "node --watch --env-file-if-exists=.env src/app.js",
    "manifest": "node --env-file-if-exists=.env src/generate-manifest.js",
    "workspace:info": "node --env-file-if-exists=.env src/workspace-info.js",
    "test": "node --test"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.4.0",
    "@google-cloud/tasks": "^7.3.1",
    "@slack/bolt": "^5.1.0",
    "@slack/web-api": "^8.2.0",
    "google-auth-library": "^11.3.1"
  }
}
