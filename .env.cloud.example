# Cloud Run runtime configuration. Store token and signing secret in Secret Manager.
SLACK_APP_NAME=Slack Broadcast
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_SIGNING_SECRET=replace-me
SLACK_TEAM_ID=T0123456789
# Live approved sender list lives in Firestore and is initialized by Terraform.
# These administrators manage that list from App Home.
SLACK_ADMIN_USER_IDS=U0123456789
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=us-central1
CLOUD_TASKS_QUEUE=slack-broadcast
TASK_SERVICE_ACCOUNT=slack-broadcast-tasks@your-project-id.iam.gserviceaccount.com
SERVICE_URL=https://slack-broadcast-xyz.us-central1.run.app
FIRESTORE_DATABASE=(default)
# Used only by npm run manifest; cloud entrypoint always uses HTTP.
APP_TRANSPORT=http
